{
	"schemaVersion": 1,
	"id": "aeonis",
	"version": "${version}",
	"name": "Aeonis",
	"description": "Aeonis is a gameplay and world-content mod for Minecraft, available for both Fabric and NeoForge. It provides player and mob transformation, AI-assisted command and control systems, custom dimensions and progression hooks, unique animated mobs, and supporting rendering and utility tooling.",
	"authors": [
		"QuantumCreeper",
		"MrMK",
		"Aevora Labs"
	],
	"contact": {
		"homepage": "https://aeonis.prenxy.app",
		"sources": "https://github.com/TheAevoraLabs/aeonis-cm",
		"issues": "https://github.com/TheAevoraLabs/aeonis-cm/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/aeonis-manager/icon.png",
	"environment": "*",
	"custom": {
		"modmenu": {
			"badges": ["library"],
			"links": {
				"modmenu.homepage": "https://aeonis.prenxy.app",
				"modmenu.github": "https://github.com/TheAevoraLabs/aeonis-cm",
				"modmenu.sources": "https://github.com/TheAevoraLabs/aeonis-cm",
				"modmenu.issues": "https://github.com/TheAevoraLabs/aeonis-cm/issues",
				"modmenu.releases": "https://github.com/TheAevoraLabs/aeonis-cm/releases"
			}
		}
	},
	"entrypoints": {
		"main": [
			{
				"value": "com.qc.aeonis.AeonisManager",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "com.qc.aeonis.AeonisManagerClient",
				"adapter": "kotlin"
			}
		],
		"fabric-datagen": [
			{
				"value": "com.qc.aeonis.AeonisManagerDataGenerator",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "com.qc.aeonis.integration.modmenu.AeonisModMenuIntegration",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"aeonis-manager.mixins.json",
		{
			"config": "aeonis-manager.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ">=26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
